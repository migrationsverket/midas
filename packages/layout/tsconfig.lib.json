{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "vite/client"
    ],
    "outDir": "out-tsc/lib"
  },
  "include": [
    "vite.config.mts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json"
  ],
  "exclude": ["**/*.spec.*", "**/*.test.*"],
  "references": [
    {
      "path": "../../tools/test-browsers/tsconfig.lib.json"
    },
    {
      "path": "../../tools/test-utils/tsconfig.lib.json"
    },
    {
      "path": "../components/tsconfig.lib.json"
    }
  ]
}
