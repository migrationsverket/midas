{
  "name": "components",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/components/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "dependsOn": ["^build"]
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "outputs": ["{options.outputFile}"],
      "dependsOn": ["^build"],
      "options": {
        "lintFilePatterns": ["packages/components/**/*.css"],
        "formatter": "unix"
      }
    }
  }
}
