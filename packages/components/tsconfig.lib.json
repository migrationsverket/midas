{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "outDir": "out-tsc/lib"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json", "package.json"],
  "exclude": ["**/*.spec.*", "**/*.test.*"],
  "references": [
    {
      "path": "../../tools/test-browsers/tsconfig.lib.json"
    },
    {
      "path": "../../tools/visual-testing/tsconfig.lib.json"
    },
    {
      "path": "../../tools/test-utils/tsconfig.lib.json"
    },
    {
      "path": "../theme/tsconfig.lib.json"
    }
  ]
}
