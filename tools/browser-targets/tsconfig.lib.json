{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Loaded from source by the Vite configs, through Node's type stripping,
    // never compiled
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
