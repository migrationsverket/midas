{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Loaded from source by the Vitest configs, through Node's type
    // stripping, never compiled
    "noEmit": true,
    "module": "nodenext",
    "target": "esnext",
    "lib": ["es2023"],
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
