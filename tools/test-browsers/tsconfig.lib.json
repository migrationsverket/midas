{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Loaded from source by the Vitest configs, through Node's type
    // stripping, never compiled. The typecheck only writes declarations
    "module": "nodenext",
    "target": "esnext",
    "lib": ["es2023"],
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "types": ["node"],
    "emitDeclarationOnly": true,
    "outDir": "out-tsc/lib"
  },
  "include": ["src/**/*.ts"]
}
