{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Loaded in the browser by Vitest through Vite, never compiled
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": [
    "src/read.ts",
    "src/read.spec.tsx",
    "src/setup.ts",
    "src/stories.ts"
  ]
}
