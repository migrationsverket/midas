{
  "name": "module-federation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build -c remote/vite.config.ts && vite build -c host/vite.config.ts",
    "preview": "concurrently -n remote,host \"vite preview -c remote/vite.config.ts\" \"vite preview -c host/vite.config.ts\"",
    "start": "npm run build && npm run preview",
    "start:react-only": "cross-env MFE_SHARE=react-only npm start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midas-ds/components": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.25.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  }
}
