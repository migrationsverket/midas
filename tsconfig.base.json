{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["es2020", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedSideEffectImports": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "importHelpers": true,
    "composite": true,
    "declarationMap": true,
    "customConditions": ["@midas-ds/source"]
  }
}
