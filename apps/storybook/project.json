{
  "name": "storybook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/storybook/src",
  "projectType": "application",
  "tags": ["apps"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx storybook dev",
        "cwd": "apps/storybook",
        "port": 4400
      }
    },
    "build": {
      "outputs": [
        "{projectRoot}/{options.output-dir}",
        "{projectRoot}/storybook-static",
        "{options.output-dir}",
        "{options.outputDir}",
        "{options.o}"
      ],
      "options": {
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/ui"
      },
      "configurations": {
        "ci": {
          "stats-json": "../../dist/docs/storybook",
          "output-dir": "../../dist/docs/storybook"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'not implemented'"
      }
    },
    "a11y": {
      "options": {
        "config": "vitest.config.ts",
        "project": "storybook"
      },
      "configurations": {
        "watch": {
          "watch": true
        }
      }
    },
    "a11y-dark-mode": {
      "options": {
        "config": "vitest.config.dark.ts",
        "project": "storybook:dark-mode"
      },
      "configurations": {
        "watch": {
          "watch": true
        }
      }
    },
    "a11y-forced-colors": {
      "options": {
        "config": "vitest.config.forced-colors.ts",
        "project": "storybook:forced-colors"
      },
      "configurations": {
        "watch": {
          "watch": true
        }
      }
    },
    "a11y-mobile": {
      "options": {
        "config": "vitest.config.mobile.ts",
        "project": "storybook:mobile"
      },
      "configurations": {
        "watch": {
          "watch": true
        }
      }
    }
  }
}
