{
  "name": "storybook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/storybook/src",
  "projectType": "application",
  "tags": ["apps"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx storybook dev",
        "cwd": "apps/storybook",
        "port": 4400
      }
    },
    "//": {
      "nx:run-commands": "Running build with @nx/storybook fails with 'Cache output is outside the workspace: ../../dist/storybook/ui'"
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/storybook/ui"],
      "options": {
        "command": "npx storybook build",
        "cwd": "apps/storybook",
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/ui"
      }
    },
    "build:ci": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/docs/storybook"],
      "options": {
        "command": "npx storybook build",
        "cwd": "apps/storybook",
        "config-dir": ".storybook",
        "stats-json": "../../dist/docs/storybook",
        "output-dir": "../../dist/docs/storybook"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'not implemented'"
      }
    },
    "a11y": {
      "options": {
        "config": "vitest.config.ts",
        "project": "storybook"
      },
      "configurations": {
        "watch": {
          "watch": true
        }
      }
    },
    "a11y-dark-mode": {
      "options": {
        "config": "vitest.config.dark.ts",
        "project": "storybook:dark-mode"
      },
      "configurations": {
        "watch": {
          "watch": true
        }
      }
    },
    "a11y-forced-colors": {
      "options": {
        "config": "vitest.config.forced-colors.ts",
        "project": "storybook:forced-colors"
      },
      "configurations": {
        "watch": {
          "watch": true
        }
      }
    },
    "a11y-mobile": {
      "options": {
        "config": "vitest.config.mobile.ts",
        "project": "storybook:mobile"
      },
      "configurations": {
        "watch": {
          "watch": true
        }
      }
    }
  }
}
