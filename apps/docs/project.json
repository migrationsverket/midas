{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/docs/src",
  "tags": ["docs", "apps"],
  "implicitDependencies": ["components", "layout", "table-styles", "logo"],
  "targets": {
    "build": {
      "executor": "@midas-ds/docusaurus:browser",
      "dependsOn": ["theme:style-dictionary-generate", "^build", "^docgen"],
      "options": {
        "outputPath": "dist/docs",
        "minify": false
      }
    },
    "serve": {
      "executor": "@midas-ds/docusaurus:dev-server",
      "options": {
        "port": 3000
      },
      "dependsOn": [
        "theme:style-dictionary-generate",
        "^docgen",
        "^docgen-watch"
      ]
    },
    "contrast-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test",
        "cwd": "apps/docs"
      }
    }
  }
}
