{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "allowJs": true,
    "lib": ["DOM", "dom.iterable"],
    "noImplicitAny": false,
    "types": [
      "node",
      "@docusaurus/module-type-aliases",
      "@docusaurus/theme-classic"
    ]
  },
  "include": ["**/*"],
  "exclude": ["**/*.test.*", "**/*.spec.*", "eslint.config.mjs"]
}
